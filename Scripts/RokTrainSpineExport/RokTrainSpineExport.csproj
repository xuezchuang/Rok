<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0618;CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- Compile the existing reference runtime in place; do not copy or modify it.
         Its embedded Spine license/copyright notices remain authoritative. -->
    <Compile Include="../../ref/client-unity/Assets/Third/Spine/spine-csharp/**/*.cs" />
  </ItemGroup>
</Project>
